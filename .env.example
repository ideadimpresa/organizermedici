# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://atxltofpzuhschgehsqx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: Supabase dashboard -> Project Settings -> API -> service_role secret.
# Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Platform settings encryption ---
# The ONE secret that must live here rather than in /admin/impostazioni:
# it's the master key used to encrypt all other keys (Brevo/Resend/Stripe)
# stored in the platform_settings table. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# --- Email + Stripe fallback (optional) ---
# Prefer configuring these from /admin/impostazioni as the superadmin —
# the app reads from there first. These env vars are only a fallback used
# if the database settings row hasn't been configured yet.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@visitaup.it
EMAIL_FROM_NAME=VisitaUp
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Cron (Vercel Cron -> /api/cron/reminders) ---
CRON_SECRET=
